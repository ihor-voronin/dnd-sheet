    "ac.total": {
      "id": "ac.total",
      "type": "number",
      "value": 15,
      "origin": "computed",
      "label": { "uk": "Клас захисту", "en": "Armor Class", "glossaryId": "combat.ac" },
      "hint": { "uk": "10 + мод. Спритності + бонус броні", "en": "10 + Dex modifier + armor bonus" },
      "editable": true,
      "formula": { "expr": "10 + mod('dex') + armor_bonus()", "deps": ["dex.score", "inventory"] }
    },
    "initiative": {
      "id": "initiative",
      "type": "number",
      "value": -1,
