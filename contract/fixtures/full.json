{
  "schemaVersion": "1.0",
  "edition": "2014",
  "title": { "uk": "Тестовий персонаж із довгим імʼям для перевірки переносів", "en": "Overflow Character With A Long Name" },
  "pages": [
    {
      "size": "A4",
      "sections": [
        {
          "id": "abilities",
          "title": { "uk": "Характеристики", "en": "Ability Scores" },
          "columns": 3,
          "fields": ["str.score", "dex.score", "con.score", "int.score", "wis.score", "cha.score"]
        },
        {
          "id": "combat",
          "title": { "uk": "Бій", "en": "Combat" },
          "columns": 2,
          "fields": ["ac.total", "initiative", "hp.current", "hp.max", "prof"]
        }
      ]
    },
    {
      "size": "A4",
      "sections": [
        {
          "id": "skills",
          "title": { "uk": "Навички", "en": "Skills" },
          "columns": 2,
          "fields": ["skill.athletics", "skill.stealth", "skill.perception"]
        },
        {
          "id": "custom",
          "title": { "uk": "Власні поля", "en": "Custom" },
          "columns": 1,
          "fields": ["custom.notes", "custom.kit", "custom.inspiration", "custom.rage"]
