# The site block of dnd.voronin.app in vps-infra's edge Caddy (/opt/edge/sites/dndsheet.caddy).
# Caddy obtains the certificate itself and redirects http:// to https://. Global options
# and the bare-IP redirect live in vps-infra's edge/Caddyfile, not here.
dnd.voronin.app {
	encode zstd gzip

	# Built files carry a content hash in their name (Vite): they never change, so browsers
	# keep them for a year. index.html has no hash and is revalidated every time.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# HTTPS only from now on; no MIME sniffing; the full URL doesn't leak to other sites.
	# No X-Frame-Options: the Telegram Mini App shows the site in a frame.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy dndsheet-app:8000
}
