# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
pytest-of-*/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.import_linter_cache/

# --- Node ---
node_modules/
frontend/dist/
*.tsbuildinfo

# --- Дані/секрети ---
.env
# Доступи до хостингу лише на цьому компʼютері (не шифровані, не для git).
deploy/local/
# Terraform: плагіни й локальні змінні (адреса сервера).
deploy/terraform/.terraform/
deploy/terraform/terraform.tfvars
*.local
*.sqlite3
.tmp/

# --- База знань: сирі тексти книг (copyright) і сесія ---
content/raw/
content/compendium/
content/bestiary/
content/.session/

# --- Згенеровані артефакти ---
artifacts/
*.pdf
!docs/**/*.pdf
server.out.log
server.err.log
.server.pid
logs/
sink-*.log
ingest-status*.txt

# --- IDE ---
.idea/
.vscode/
!_vscode/

# --- Бекапи/чернетки ---
*.bak
*.bak.*


# --- Похідні індекси з корпусу (збираються скриптами) ---
content/index/


# --- Тимчасові теки тестів (пісочниця не дає писати в %TEMP%) ---
backend/tests/**/_tmp_*/

# --- Дані застосунку: чернетки візарда й збережені персонажі ---
var/

# Terraform: блокування стану на час запуску (тимчасовий файл).
deploy/secrets/terraform/.terraform.tfstate.lock.info
