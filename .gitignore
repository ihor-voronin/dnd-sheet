# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
pytest-of-*/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.import_linter_cache/

# --- Node ---
node_modules/
frontend/dist/
*.tsbuildinfo

# --- Data/secrets ---
.env
# Temporary deploy files (the compressed image). Credentials live in deploy/secrets (git-crypt).
deploy/local/
# Terraform: plugins and local variables (the server address).
deploy/terraform/.terraform/
# The Terraform state is kept only encrypted in deploy/secrets/terraform; the copies Terraform
# puts next to it (state rm, backup) are plaintext and must not reach git.
deploy/terraform/*.tfstate*
deploy/terraform/terraform.tfvars
*.local
*.sqlite3
.tmp/

# --- Knowledge base: raw book texts (copyright) and the session ---
# The corpus (content/compendium, bestiary, index) is in git, but encrypted by git-crypt:
# the rules are in their .gitattributes. Raw book texts and the session stay local.
content/raw/
content/.session/

# --- Generated artifacts ---
artifacts/
*.pdf
!docs/**/*.pdf
server.out.log
server.err.log
.server.pid
logs/
sink-*.log
ingest-status*.txt

# --- IDE ---
.idea/
.vscode/
!_vscode/

# --- Backups/drafts ---
*.bak
*.bak.*




# --- Temporary test folders (the sandbox doesn't allow writing to %TEMP%) ---
backend/tests/**/_tmp_*/

# --- App data: wizard drafts and saved characters ---
var/

# Terraform: the state lock during a run (a temporary file).
deploy/secrets/terraform/.terraform.tfstate.lock.info
